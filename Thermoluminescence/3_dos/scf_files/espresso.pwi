&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'BeO_Electronic'
   disk_io          = 'low'
   pseudo_dir       = './'
/
&SYSTEM
   ibrav            = 0
   nat              = 4
   ntyp             = 2
   ecutwfc          = 125
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
/
&ELECTRONS
   electron_maxstep = 100
   conv_thr         = 1e-10
   mixing_beta      = 0.2
   diagonalization  = 'david'
   diago_full_acc   = .true.
   startingpot      = 'atomic'
   startingwfc      = 'atomic+random'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Be 9.0121831 Be.upf
O 15.999 O.upf

K_POINTS automatic
10 10 5  0 0 0

