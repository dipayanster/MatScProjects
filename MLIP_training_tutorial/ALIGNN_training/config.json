{
  "version": "1123",
  "random_seed": 123,
  "dataset": "user_data",
  "target": "energy_per_atom",
  "model": {
    "name": "alignn_atomwise_pure",
    "alignn_layers": 2,
    "gcn_layers": 2,
    "atom_input_features": 92,
    "edge_input_features": 80,
    "triplet_input_features": 40,
    "embedding_features": 64,
    "hidden_features": 64,
    "output_features": 1,
    "calculate_gradient": true,
    "graphwise_weight": 10.0,
    "gradwise_weight": 100.0,
    "stresswise_weight": 0.0
  },
  "neighbor_strategy": "pure_torch",
  "optimizer": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 1e-05,
  "batch_size": 16,
  "epochs": 500,
  "scheduler": "onecycle",
  "train_ratio": 0.7,
  "val_ratio": 0.2,
  "test_ratio": 0.1,
  "keep_data_order": true,
  "n_early_stopping": 50
}